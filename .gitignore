cat > .gitignore << 'EOF'
# Frontend (Node.js/React/Vite)
node_modules/
dist/
.vite/
*.local
.env
.env.local
.env.*.local
coverage/
.cache/

# Backend (Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.mypy_cache/
.dmypy.json
dmypy.json

# Database files
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# IDE/Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store

# OS-specific
Thumbs.db
*.bak
*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
EOF